APP_NAME="ULEAM Movilidad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.invalid

# Configurar la URL/origen reales del frontend en el entorno de despliegue.
CORS_ALLOWED_ORIGINS=https://app.example.invalid
ALLOW_PUBLIC_REGISTER=false
SANCTUM_TOKEN_EXPIRATION=480
PAGINATION_PER_PAGE=10
STUDENT_SEARCH_PER_PAGE=10

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Ejemplo de conexión PostgreSQL. Completar desde el gestor de secretos.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=movilidad
DB_USERNAME=movilidad_app
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Opcionales; inyectar solo si se configura el servicio correspondiente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
